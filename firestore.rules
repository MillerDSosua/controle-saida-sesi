rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CONTROLE DE SAÍDA SESI - SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a Database-Based Access Control (DBAC) model where user roles
     * ('operator', 'viewer') are stored in the '/users' collection.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isOperator() {
      return hasRole('operator');
    }

    function isViewer() {
      return hasRole('viewer');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Rules for the User collection.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Rules for Classes. Managed by Operators, readable by any signed-in user.
     */
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow write: if isOperator();
    }

    /**
     * @description Rules for Students. Managed exclusively by Operators.
     */
    match /students/{studentId} {
      allow get, list: if isOperator();
      allow write: if isOperator();
    }

    /**
     * @description Rules for Escolares. Managed by Operators, readable by any signed-in user.
     */
    match /escolares/{escolarId} {
      allow get, list: if isSignedIn();
      allow write: if isOperator();
    }

    /**
     * @description Rules for Call records. Supports real-time monitoring.
     */
    match /calls/{callId} {
      allow get, list: if isSignedIn();
      allow write: if isOperator();
    }

  }
}