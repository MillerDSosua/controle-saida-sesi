rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---

    /**
     * Verifica se o usuário está autenticado no Firebase Auth.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Obtém os dados do documento do usuário na coleção /users.
     */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Verifica se o usuário autenticado possui o papel de operador.
     */
    function isOperator() {
      return isSignedIn() && getUserData().role == "operator";
    }

    /**
     * Verifica se o usuário autenticado possui o papel de visitante (viewer).
     */
    function isViewer() {
      return isSignedIn() && getUserData().role == "viewer";
    }

    // --- REGRAS POR COLEÇÃO ---

    /**
     * Usuários: Cada usuário lê e escreve apenas seu próprio perfil.
     */
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Turmas: Leitura para todos os autenticados. Escrita apenas para operadores.
     */
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    /**
     * Alunos: Leitura para todos os autenticados. Escrita apenas para operadores.
     */
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    /**
     * Escolares: Leitura para todos os autenticados. Escrita apenas para operadores.
     */
    match /escolares/{escolarId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    /**
     * Chamadas (calls): 
     * - Leitura (get/list): Permitida para operadores e visitantes.
     * - Escrita: Permitida apenas para operadores.
     */
    match /calls/{callId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
  }
}