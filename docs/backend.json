
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile with access roles for the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity (Firebase Auth UID)."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The user's role, determining their access level.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "email",
        "role"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student registered in the system, associated with a specific class and optionally an escolar.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Student entity."
        },
        "nomeExibicao": {
          "type": "string",
          "description": "The student's display name."
        },
        "turmaId": {
          "type": "string",
          "description": "Reference to Class."
        },
        "turmaNome": {
          "type": "string",
          "description": "Denormalized name of the class."
        },
        "escolarId": {
          "type": "string",
          "description": "Optional reference to an Escolar transport."
        },
        "escolarNome": {
          "type": "string",
          "description": "Denormalized name of the escolar transport."
        },
        "ativo": {
          "type": "boolean",
          "description": "Indicates if the student record is currently active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "nomeExibicao",
        "turmaId",
        "turmaNome",
        "ativo",
        "createdAt",
        "updatedAt"
      ]
    },
    "Class": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Class",
      "type": "object",
      "description": "Represents a class (turma) within the educational institution.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Class entity."
        },
        "nome": {
          "type": "string",
          "description": "The name of the class."
        },
        "ativa": {
          "type": "boolean",
          "description": "Indicates if the class is currently active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "nome",
        "ativa",
        "createdAt",
        "updatedAt"
      ]
    },
    "Escolar": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Escolar",
      "type": "object",
      "description": "Represents a school transport service (escolar).",
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "ativo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "nome",
        "ativo",
        "createdAt",
        "updatedAt"
      ]
    },
    "Call": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Call",
      "type": "object",
      "description": "Records an instance of a student or escolar being 'called out'.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tipo": {
          "type": "string",
          "description": "Type of call: 'aluno' or 'escolar'."
        },
        "studentId": {
          "type": "string"
        },
        "nomeExibicao": {
          "type": "string"
        },
        "turmaId": {
          "type": "string"
        },
        "turmaNome": {
          "type": "string"
        },
        "escolarId": {
          "type": "string"
        },
        "escolarNome": {
          "type": "string"
        },
        "turmasRelacionadas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For escolar calls, list of associated class IDs."
        },
        "status": {
          "type": "string"
        },
        "dataHoraChamado": {
          "type": "string",
          "format": "date-time"
        },
        "diaRef": {
          "type": "string",
          "format": "date"
        },
        "chamadoPorUid": {
          "type": "string"
        },
        "chamadoPorEmail": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tipo",
        "status",
        "dataHoraChamado",
        "diaRef",
        "chamadoPorUid",
        "chamadoPorEmail",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User" } },
      { "path": "/classes/{classId}", "definition": { "entityName": "Class" } },
      { "path": "/students/{studentId}", "definition": { "entityName": "Student" } },
      { "path": "/escolares/{escolarId}", "definition": { "entityName": "Escolar" } },
      { "path": "/calls/{callId}", "definition": { "entityName": "Call" } }
    ]
  }
}
